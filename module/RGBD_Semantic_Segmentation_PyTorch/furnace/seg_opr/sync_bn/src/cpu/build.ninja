ninja_required_version = 1.3
cxx = c++

cflags = -DTORCH_EXTENSION_NAME=syncbn_cpu -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/dragauler/code_env/.pixi/envs/default/include -isystem /home/dragauler/code_env/.pixi/envs/default/lib/python3.12/site-packages/torch/include -isystem /home/dragauler/code_env/.pixi/envs/default/include/torch/csrc/api/include -isystem /home/dragauler/code_env/.pixi/envs/default/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /home/dragauler/code_env/.pixi/envs/default/include/python3.12 -fPIC -std=c++17
post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/dragauler/code_env/.pixi/envs/default/lib/python3.12/site-packages/torch/lib -lc10 -ltorch_cpu -ltorch -ltorch_python

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





rule link
  command = $cxx $in $ldflags -o $out

build operator.o: compile /home/dragauler/code_env/lib_thesis/RGBD_Semantic_Segmentation_PyTorch/furnace/seg_opr/sync_bn/src/cpu/operator.cpp
build syncbn_cpu.o: compile /home/dragauler/code_env/lib_thesis/RGBD_Semantic_Segmentation_PyTorch/furnace/seg_opr/sync_bn/src/cpu/syncbn_cpu.cpp





build syncbn_cpu.so: link operator.o syncbn_cpu.o

default syncbn_cpu.so
