ninja_required_version = 1.3
cxx = c++
nvcc = /home/dragauler/code_env/.pixi/envs/default/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=syncbn_gpu -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/dragauler/code_env/.pixi/envs/default/include -isystem /home/dragauler/code_env/.pixi/envs/default/lib/python3.12/site-packages/torch/include -isystem /home/dragauler/code_env/.pixi/envs/default/include/torch/csrc/api/include -isystem /home/dragauler/code_env/.pixi/envs/default/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /home/dragauler/code_env/.pixi/envs/default/include/python3.12 -fPIC -std=c++17
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=syncbn_gpu -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/dragauler/code_env/.pixi/envs/default/include -isystem /home/dragauler/code_env/.pixi/envs/default/lib/python3.12/site-packages/torch/include -isystem /home/dragauler/code_env/.pixi/envs/default/include/torch/csrc/api/include -isystem /home/dragauler/code_env/.pixi/envs/default/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /home/dragauler/code_env/.pixi/envs/default/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_120,code=compute_120 -gencode=arch=compute_120,code=sm_120 --compiler-options '-fPIC' -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/dragauler/code_env/.pixi/envs/default/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/home/dragauler/code_env/.pixi/envs/default/lib -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build operator.o: compile /home/dragauler/code_env/lib_thesis/RGBD_Semantic_Segmentation_PyTorch/furnace/seg_opr/sync_bn/src/gpu/operator.cpp
build syncbn_kernel.cuda.o: cuda_compile /home/dragauler/code_env/lib_thesis/RGBD_Semantic_Segmentation_PyTorch/furnace/seg_opr/sync_bn/src/gpu/syncbn_kernel.cu





build syncbn_gpu.so: link operator.o syncbn_kernel.cuda.o

default syncbn_gpu.so
